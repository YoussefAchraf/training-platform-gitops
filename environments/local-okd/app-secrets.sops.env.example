# NOT applied automatically - plaintext template. Copy this to
# environments/local-okd/app-secrets.plaintext.env (gitignored), fill in
# real values, then encrypt it with sops (docs/runbook.md's "Deploy
# Vault FIRST" section) to produce
# environments/local-okd/app-secrets.sops.env - the actual committed,
# SOPS+age-encrypted file scripts/vault-seed.js reads.
#
# Keys map onto Vault as follows (docs/secrets-inventory.md has the full
# picture, including which chart/pod consumes each one downstream):
#   training-platform/data/backend  <- POSTGRES_PASSWORD, BACKEND_REDIS_PASSWORD,
#                                       JWT_SECRET, SMTP_USER, SMTP_PASS,
#                                       VAPID_PRIVATE_KEY
#   training-platform/data/postgres <- POSTGRES_PASSWORD (same value, see below)
#   training-platform/data/n8n      <- N8N_ENCRYPTION_KEY, N8N_OWNER_PASSWORD,
#                                       N8N_AI_API_KEY, CHATBOT_REDIS_PASSWORD
#
# POSTGRES_PASSWORD is deliberately ONE value feeding two Vault paths, not
# independently generated per path - a past incident had these drift apart.
#
# BACKEND_REDIS_PASSWORD / CHATBOT_REDIS_PASSWORD are two DIFFERENT values
# for two separate redis instances - do not reuse one for both.

POSTGRES_PASSWORD=REPLACE_ME
BACKEND_REDIS_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
N8N_ENCRYPTION_KEY=REPLACE_ME
N8N_OWNER_PASSWORD=REPLACE_ME
N8N_AI_API_KEY=REPLACE_ME
CHATBOT_REDIS_PASSWORD=REPLACE_ME
